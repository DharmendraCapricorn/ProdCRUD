@model ProductViewModel
@{
    ViewData["Title"] = "Delete product";
}

<h1 class="h3 mb-3 text-danger">Delete product</h1>

<div class="card card-body" style="max-width:520px">
    <p>Are you sure you want to delete this product? This cannot be undone.</p>
    <dl class="row mb-3">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Price.ToString("C")</dd>
        <dt class="col-sm-3">Stock</dt>
        <dd class="col-sm-9">@Model.Stock</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>
