@model ProductIndexViewModel
@inject IOptions<ApiOptions> Api
@{
    ViewData["Title"] = "Products";
    var baseUrl = Api.Value.BaseUrl.TrimEnd('/');
    var f = Model.Filter;
    var p = Model.Page;

    // Route values that carry the active filters through pagination links.
    var baseRoute = new Dictionary<string, string>();
    foreach (var kv in f.ToRouteValues())
        if (!string.IsNullOrEmpty(kv.Value)) baseRoute[kv.Key] = kv.Value!;
    var prevData = new Dictionary<string, string>(baseRoute) { ["Page"] = (p.Page - 1).ToString() };
    var nextData = new Dictionary<string, string>(baseRoute) { ["Page"] = (p.Page + 1).ToString() };

    var from = p.TotalCount == 0 ? 0 : (p.Page - 1) * p.PageSize + 1;
    var to = Math.Min(p.Page * p.PageSize, p.TotalCount);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Products</h1>
    <a class="btn btn-primary" asp-action="Create">+ New product</a>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md">
            <label class="form-label small text-muted mb-1">Search</label>
            <input name="Search" value="@f.Search" class="form-control" placeholder="Name or description…" />
        </div>
        <div class="col-auto">
            <label class="form-label small text-muted mb-1">Min $</label>
            <input name="MinPrice" value="@(f.MinPrice?.ToString())" type="number" step="0.01" min="0" class="form-control" style="width:100px" />
        </div>
        <div class="col-auto">
            <label class="form-label small text-muted mb-1">Max $</label>
            <input name="MaxPrice" value="@(f.MaxPrice?.ToString())" type="number" step="0.01" min="0" class="form-control" style="width:100px" />
        </div>
        <div class="col-auto">
            <label class="form-label small text-muted mb-1">Stock</label>
            <select name="InStock" class="form-select">
                <option value="">All</option>
                <option value="true" selected="@(f.InStock == true)">In stock</option>
                <option value="false" selected="@(f.InStock == false)">Out of stock</option>
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small text-muted mb-1">Sort by</label>
            <select name="SortBy" class="form-select">
                <option value="" selected="@(string.IsNullOrEmpty(f.SortBy))">Default</option>
                <option value="name" selected="@(f.SortBy == "name")">Name</option>
                <option value="price" selected="@(f.SortBy == "price")">Price</option>
                <option value="stock" selected="@(f.SortBy == "stock")">Stock</option>
                <option value="createdAt" selected="@(f.SortBy == "createdAt")">Created</option>
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label small text-muted mb-1">Order</label>
            <select name="Desc" class="form-select">
                <option value="false" selected="@(!f.Desc)">Asc</option>
                <option value="true" selected="@(f.Desc)">Desc</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    </div>
</form>

<div class="card">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th class="text-end">Price</th>
                <th class="text-end">Stock</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!p.Items.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        @(f.HasFilters ? "No products match your filters." : "No products yet. Create one to get started.")
                    </td>
                </tr>
            }
            else
            {
                @foreach (var product in p.Items)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(product.ImagePath))
                            {
                                <img src="@(baseUrl + product.ImagePath)" alt="@product.Name"
                                     style="width:44px;height:44px;object-fit:cover;border-radius:8px;" />
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@product.Name</td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(product.Description) ? "—" : product.Description)</td>
                        <td class="text-end">@product.Price.ToString("C")</td>
                        <td class="text-end">@product.Stock</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-link">Details</a>
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-link">Edit</a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-link text-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@if (p.TotalCount > 0)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">@from–@to of @p.TotalCount</span>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(p.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="prevData">‹ Prev</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Page @p.Page of @p.TotalPages</span>
                </li>
                <li class="page-item @(p.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="nextData">Next ›</a>
                </li>
            </ul>
        </nav>
    </div>
}
