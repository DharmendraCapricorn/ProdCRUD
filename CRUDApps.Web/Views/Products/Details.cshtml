@model ProductViewModel
@inject IOptions<ApiOptions> Api
@{
    ViewData["Title"] = Model.Name;
    var baseUrl = Api.Value.BaseUrl.TrimEnd('/');
}

<h1 class="h3 mb-3">@Model.Name</h1>

<div class="card card-body" style="max-width:640px">
    <div class="row">
        <div class="col-auto">
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@(baseUrl + Model.ImagePath)" alt="@Model.Name"
                     style="width:180px;height:180px;object-fit:cover;border-radius:10px;" />
            }
            else
            {
                <div class="d-flex align-items-center justify-content-center text-muted bg-light"
                     style="width:180px;height:180px;border-radius:10px;">No image</div>
            }
        </div>
        <div class="col">
            <dl class="row mb-0">
                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">@Model.Price.ToString("C")</dd>

                <dt class="col-sm-4">Stock</dt>
                <dd class="col-sm-8">@Model.Stock</dd>

                <dt class="col-sm-4">Created</dt>
                <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("g")</dd>

                <dt class="col-sm-4">Updated</dt>
                <dd class="col-sm-8">@(Model.UpdatedAt?.ToLocalTime().ToString("g") ?? "—")</dd>
            </dl>
        </div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to list</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    </div>
</div>
